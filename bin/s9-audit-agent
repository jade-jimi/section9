#!/usr/bin/env python3
"""section9 delegation audit hook (Claude Code PostToolUse, matcher=Agent).

리드가 Agent 툴로 위임한 순간, 그 위임을 **사람의 기억이 아니라 구조로** 등록한다
(REQ-20260825-088, 설계 DOC-20260825-003):

  1. active_reqs 클레임        — 병렬 위임이 대시보드에서 보이게
  2. agent_transcript_path 누적 — 그 에이전트의 활동이 live 신선도의 근거가 되게
  3. contributions 에 running   — "어느 항목을 누가 지금 하고 있는가"를 문서에

배경: 2026-08-25 위임 에이전트 2개가 병렬로 돌았는데 리드가 `s9 last --add` 와
transcript 등록을 잊어 화면에 아무것도 안 보였다. 수동 규약은 남기되 기본을
자동으로 바꾼다 — 잊을 수 있는 경로는 언젠가 반드시 잊힌다.

PostToolUse 시점을 고르는 이유: PreToolUse 에는 agentId·output_file 이 아직 없다.
이 하네스의 Agent 툴은 백그라운드 스폰이라 tool_response 가 **시작 시점에**
agentId/output_file 을 돌려준다 — 즉 이 훅은 종료가 아니라 기동 시점에 돈다.
종료 시점의 마감(result=done)은 SubagentStop 훅(s9-audit-subagent)이 맡는다.

귀속 대상은 **위임을 띄운 쪽이 지명한 REQ** 를 먼저 본다 (REQ-20260828-041).
세션 클레임만 보던 종전 규칙은 리드가 자기가 클레임하지 않은 문서에 위임하면
그 위임을 엉뚱한 REQ 에 붙였다 — 2026-08-28 21:10 designer 는 039 를 작업 중인데
기록은 028 로 갔고, 039 는 화면에서 "69분째 진전 없음" 이 됐다. 지명이 없거나
유일하지 않으면 종전 경로(클레임)로 물러난다.

원칙: 실패 시 조용히 exit 0. 문서를 건드릴 근거가 없으면 아무것도 하지 않는다.
비활성화: S9_AUDIT=off
"""
import json
import os
import re
import subprocess
import sys

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")

AID_RE = re.compile(r"agentId[\"'\s:=]+([0-9a-zA-Z_-]+)")
OUT_RE = re.compile(r"output_file[\"'\s:=]+(\S+?)[\"',\s]*$", re.M)


def _detect_root(data):
    """세션 cwd가 s9 인스턴스면 그 루트를 S9_ROOT로 승격 (REQ-20260824-053)."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd


def run(env, *argv):
    return subprocess.run([S9, *argv], capture_output=True, text=True,
                          env=env, timeout=15)


def parse_agent_result(resp):
    """Agent 툴 응답 → (agentId, output_file). 못 읽으면 ('', '').

    하네스가 dict 를 주기도 하고 사람이 읽는 텍스트를 주기도 한다 — 둘 다 받는다.
    파싱 실패를 예외로 올리지 않는 이유: 이 훅의 실패는 감사 공백일 뿐이고,
    툴 사용 자체를 막아선 안 된다."""
    if isinstance(resp, dict):
        aid = str(resp.get("agentId") or resp.get("agent_id") or "")
        out = str(resp.get("output_file") or resp.get("outputFile") or "")
        if aid and out:
            return aid, out
        resp = json.dumps(resp, ensure_ascii=False)
    if isinstance(resp, list):
        resp = "\n".join(
            x.get("text", "") if isinstance(x, dict) else str(x) for x in resp)
    if not isinstance(resp, str):
        return "", ""
    m1, m2 = AID_RE.search(resp), OUT_RE.search(resp)
    if not (m1 and m2):
        return "", ""
    return m1.group(1), m2.group(1).strip("\"',")


def actor_for(agent_type, agent_id):
    """위임 에이전트의 actor 규격 문자열 — sub:<타입>:<agentId8>."""
    t = (agent_type or "subagent").strip() or "subagent"
    return "sub:%s:%s" % (t, (agent_id or "")[:8]) if agent_id else "sub:%s" % t


REQ_RE = re.compile(r"\bREQ-\d{8}-\d{1,5}(?:-[0-9a-z]{2,8})?\b")
NAME_SCAN_MAX = 8       # 지명 후보 조회 상한 — 훅은 툴 호출마다 돈다


def named_reqs(inp):
    """위임을 띄운 쪽이 **지명한** REQ id — 등장 순, 중복 제거.

    description 을 먼저 보는 이유: 리드가 대상을 명시적으로 적는 자리이고,
    프롬프트에는 배경으로 언급되는 다른 id 가 섞이기 쉽다."""
    inp = inp or {}
    text = "\n".join(str(inp.get(k) or "") for k in ("description", "prompt"))
    return list(dict.fromkeys(REQ_RE.findall(text)))[:NAME_SCAN_MAX]


def doc_meta(env, rid):
    """(정식 id, status). 문서가 없으면 ("", "").

    짧은 id 지명도 정식 id 로 돌려준다 — 클레임·기여가 짧은 형태로 저장되면
    live 매칭과 클레임 판정이 깨진다 (REQ-20260825-086)."""
    r = run(env, "show", rid, "--meta")
    if r.returncode != 0:
        return "", ""
    cid = status = ""
    for line in (r.stdout or "").splitlines():
        if line.startswith("id:") and not cid:
            cid = line.split(":", 1)[1].strip()
        elif line.startswith("status:") and not status:
            status = line.split(":", 1)[1].strip()
    return cid, status


def named_target(env, inp):
    """지명된 것 중 **살아 있는 하나** — 없거나 여럿이면 "" (고르지 않는다).

    위임을 띄우는 쪽은 대상을 알고 있다. 그 값을 읽는 것이 세션 클레임에서
    추측하는 것보다 언제나 낫다 — 리드가 자기가 클레임하지 않은 문서에 위임하는
    일이 흔하고(실사고 2026-08-28 21:10: designer 는 039 를 하는데 기록은 028 에
    붙었다), 그러면 도는 요청이 화면에서 '멈춤' 이 된다.

    **유일하지 않으면 고르지 않는다.** 프롬프트에는 배경 설명으로 다른 REQ 가
    함께 실린다 — 그중 하나를 골라 running 을 심으면 남의 문서가 영원히
    '진행 중'으로 보인다. 여럿이면 세션 클레임 경로로 물러난다."""
    live = []
    for rid in named_reqs(inp):
        cid, status = doc_meta(env, rid)
        if cid and status not in ("done", "cancelled") and cid not in live:
            live.append(cid)
    return live[0] if len(live) == 1 else ""


def target_req(env, inp=None, out=None):
    """이 위임을 귀속할 REQ — ① 지명된 것 ② 세션이 실행 등록한 것 순.

    ②에서 언급 기반 추측은 하지 않는다: 위임 시점엔 아직 보고 본문이 없고,
    추측으로 남의 문서에 running 을 심으면 그 문서가 영원히 '진행 중'으로 보인다.
    ①은 추측이 아니다 — 위임을 띄운 리드가 대상을 적은 값이다.
    out: 넘기면 어느 경로로 골랐는지 담는다(로그용) — 오귀속을 사후에 추적하려면
    "무엇에 붙였나" 만으로는 부족하고 "왜 그것이었나" 가 있어야 한다."""
    if out is None:
        out = {}
    named = named_target(env, inp)
    if named:
        out["src"] = "지명"
        return named
    out["src"] = "클레임"
    try:
        b = json.loads(run(env, "bind").stdout or "{}")
    except ValueError:
        return ""
    # **끝난 문서는 후보가 아니다** (REQ-20260828-036). 소유만 보고 상태를 안
    # 보던 탓에, 13:35 에 done 된 REQ 가 그 뒤 위임 네 건을 전부 빨아들였다 —
    # 화면은 끝난 문서를 "에이전트 4명 작업 중" 으로 그렸고, 그 문서는
    # agent_health 의 시야(in-progress) 밖이라 좀비 기여가 마감되지도 않았다.
    # 그리고 **최근 클레임 우선**으로 고른다: last_req 를 먼저 보면 오래된
    # 포인터가 새 위임을 계속 가로챈다. bin/s9 의 _capture_target 과 같은 순서다.
    cands = [x for x in [*reversed(b.get("active_reqs") or []),
                         (b.get("last_req") or "").strip()] if x]
    for rid in dict.fromkeys(cands):
        if run(env, "last", "--owns", rid).stdout.strip() != rid:
            continue
        st = run(env, "show", rid, "--meta").stdout
        if any(f"status: {t}" in st for t in ("done", "cancelled")):
            continue
        return rid
    return ""


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    if (data.get("tool_name") or "") != "Agent":
        return
    _detect_root(data)
    aid, out = parse_agent_result(data.get("tool_response"))
    if not (aid and out):
        return

    env = dict(os.environ)
    env["S9_SESSION"] = (data.get("session_id") or "unknown")[:8]
    inp = data.get("tool_input") or {}
    pick = {}
    req = target_req(env, inp, pick)
    if not req:
        run(env, "log", f"위임 등록 보류: 대상 REQ 없음 (agent {aid[:8]})")
        return

    run(env, "claim", req, "--agent-transcript", out)
    run(env, "contrib", req,
        "--actor", actor_for(inp.get("subagent_type"), aid),
        "--item", (inp.get("description") or "")[:120],
        "--result", "running", "--transcript", out)
    run(env, "log", f"위임 등록: {req} ← "
                    f"{actor_for(inp.get('subagent_type'), aid)} "
                    f"({pick.get('src', '?')})")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
