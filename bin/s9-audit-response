#!/usr/bin/env python3
"""section9 response audit hook (Claude Code Stop).

턴이 끝날 때 transcript에서 어시스턴트의 마지막 응답 텍스트를 추출해,
이 세션의 진행 중 REQ(binding.last_req)의 ## Notes 에 append 한다.
→ 터미널에만 남던 작업 보고/구현 설명이 문서에 영구 기록된다.

Request 턴에만 붙는다 — 프롬프트 훅이 Request일 때 last_req를 set,
Question/Nothing일 때 pause 하므로 엉뚱한 REQ에 붙지 않는다
(last_req 자체는 유지 — 진행 중 위임 캡처/스트림 활성 판정 보존, REQ-20260823-072).

원칙: 실패 시 조용히 exit 0. 비활성화: S9_AUDIT=off
"""
import json
import os
import shutil
import subprocess
import sys

S9 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "s9")
MAX_CHARS = 12000



def _detect_root(data):
    """세션 cwd가 s9 리포(인스턴스)면 그 루트를 S9_ROOT로 승격 — 한 머신에서
    업스트림 카피와 인스턴스를 병행할 때 기록이 세션 위치를 따라간다
    (REQ-20260824-053). 명시된 S9_ROOT가 항상 우선."""
    if os.environ.get("S9_ROOT"):
        return
    cwd = (data.get("cwd") or "").strip()
    if cwd and os.path.exists(os.path.join(cwd, "bin", "s9")) \
            and os.path.isdir(os.path.join(cwd, "vault")):
        os.environ["S9_ROOT"] = cwd

def mirror_transcript(tp):
    """transcript를 section9/streams/ 로 복사 — 파일명은 원본 basename(=전체SID.jsonl).
    resume이 찾는 이름과 100% 일치해 크로스머신 resume 가능(DOC-20260823-002).
    vault와 함께 git 동기화되어 다른 머신/계정에서도 스트림/세션 복원 가능."""
    try:
        root = os.environ.get("S9_ROOT") or os.path.dirname(
            os.path.dirname(os.path.realpath(__file__)))
        dst = os.path.join(root, "streams")
        os.makedirs(dst, exist_ok=True)
        shutil.copyfile(tp, os.path.join(dst, os.path.basename(tp)))
    except Exception:
        pass


def run(env, *argv, inp=None):
    return subprocess.run([S9, *argv], input=inp, capture_output=True,
                          text=True, env=env, timeout=15)


def last_assistant_text(transcript_path):
    """마지막 assistant 텍스트와 그 model 을 함께 반환 (text, model).
    model 은 리드 에이전트 귀속(--agent lead:<model>)에 쓴다."""
    text, model = None, None
    with open(transcript_path, encoding="utf-8") as f:
        for line in f:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if obj.get("type") != "assistant":
                continue
            msg = obj.get("message") or {}
            parts = [c.get("text", "") for c in (msg.get("content") or [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            t = "\n\n".join(p for p in parts if p).strip()
            if t:
                text = t
                model = msg.get("model") or model
    return text, model


def main():
    if os.environ.get("S9_AUDIT", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    _detect_root(data)
    if data.get("stop_hook_active"):
        return
    tp = data.get("transcript_path")
    if not tp or not os.path.exists(tp):
        return
    session = (data.get("session_id") or "unknown")[:8]
    env = dict(os.environ)
    env["S9_SESSION"] = session
    mirror_transcript(tp)  # 분류와 무관하게 매 턴 스트림 미러링 (전체SID 파일명)
    run(env, "bind", "transcript_path", tp)  # live tail 경로 갱신
    run(env, "bind", "cwd", data.get("cwd", ""))  # resume용 cwd

    text, model = last_assistant_text(tp)
    if not text:
        return
    req = run(env, "last", "--active").stdout.strip()
    if not req:
        return  # Question/Nothing 턴(pause) — 응답은 문서에 붙이지 않음
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS] + "\n\n…(truncated)"
    # 리드 에이전트 귀속: 오케스트레이터(메인 세션)를 lead:<model> 로 기록
    agent = f"lead:{model}" if model else "lead"
    out = run(env, "note", req, "--label", "response", "--agent", agent, inp=text)
    if out.returncode == 0:
        run(env, "log", f"response → {req} by {agent} ({len(text)} chars)")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
