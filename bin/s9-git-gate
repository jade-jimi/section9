#!/usr/bin/env python3
"""파괴적 git 명령 기계 게이트 — PreToolUse(Bash) 훅 (REQ-20260901-010).

실사고 2026-09-01: 위임 에이전트의 `git stash push`→(pop 실패)→`git stash drop`
이 남의 미커밋 전이·노트 113건을 작업 트리에서 걷어 갔다 (REQ-20260901-004).
봉투의 금지 문구는 그 에이전트에게 닿지 않았고, 닿았어도 규율은 지켜지지
않을 때를 대비하지 못한다(REQ-20260826-021) — pre-commit 훅(s9-guard)은
커밋만 보고, 작업 트리를 되돌리는 명령은 아예 보지 못한다. 그래서 명령이
실행되기 **전**에 서는 기계 게이트가 이 자리다.

판정: stdin 의 PreToolUse JSON 에서 Bash command 를 읽어, **이 저장소를
향한** 작업 트리 파괴 명령이면 exit 2 + stderr 사유로 거부한다.
- 막는 것: stash(list/show 제외) · checkout 의 경로 되돌림(`--`·`.`·`-f`) ·
  reset --hard/--merge · restore(작업 트리) · clean -f/-d/-x
- 지나가는 것: 읽기(status/log/diff/show)·commit·push·stash list 등, 다른
  저장소를 향한 명령, `S9_GIT_OK=1` 을 명령 앞에 붙인 의식적 우회 한 줄.
- 판정 불가(JSON 아님 등)는 통과다 — 게이트 고장이 모든 Bash 를 막으면
  그날로 게이트가 뽑힌다.
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

BLOCK = [
    # (정규식, 사람이 읽을 이름). 명령 문자열 전체에 대해 재므로 체인
    # (`a && git stash`)·서브셸도 걸린다. stash 는 list/show 만 살린다.
    # stash 하위명령으로 판정한다 — 인자 `stash@{0}` 의 둘째 stash 나 뒤쪽
    # 어딘가의 show 낱말에 속지 않게, stash 바로 다음 낱말만 본다.
    (r"\bgit\b[^|;&]*\bstash\b(?![@\w])(?!\s+(list|show)\b)", "git stash"),
    (r"\bgit\b[^|;&]*\breset\b[^|;&]*(--hard|--merge)", "git reset --hard"),
    (r"\bgit\b[^|;&]*\bcheckout\b[^|;&]*(\s--(\s|$)|\s-f\b|\s--force\b|\s\.(\s|$))",
     "git checkout(작업 트리 되돌림)"),
    (r"\bgit\b[^|;&]*\brestore\b(?![^|;&]*--staged(?![^|;&]*--worktree))",
     "git restore(작업 트리)"),
    (r"\bgit\b[^|;&]*\bclean\b[^|;&]*\s-[a-zA-Z]*[fdx]", "git clean"),
]


def targets_this_repo(cmd, cwd):
    """명령이 이 저장소의 작업 트리를 향하는가 — cwd 가 저장소 안이거나,
    `-C <경로>`/절대 경로 인자가 저장소를 가리킬 때."""
    try:
        if os.path.realpath(cwd or os.getcwd()).startswith(
                os.path.realpath(ROOT)):
            return True
    except OSError:
        pass
    for m in re.finditer(r"-C\s+(\S+)", cmd):
        try:
            if os.path.realpath(os.path.expanduser(
                    m.group(1))).startswith(os.path.realpath(ROOT)):
                return True
        except OSError:
            continue
    return ROOT in cmd


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0
    if payload.get("tool_name") != "Bash":
        return 0
    cmd = str((payload.get("tool_input") or {}).get("command") or "")
    if not cmd or "git" not in cmd:
        return 0
    # 의식적 우회 — 사람이 그 명령 앞에 직접 붙이는 한 줄. 환경 상속이 아니라
    # 명령 문자열에 있어야 한다: 워커 봉투가 통째로 물려주는 것을 막는다.
    if re.search(r"\bS9_GIT_OK=1\b", cmd):
        return 0
    if not targets_this_repo(cmd, payload.get("cwd", "")):
        return 0
    for pat, name in BLOCK:
        if re.search(pat, cmd):
            sys.stderr.write(
                f"[s9-git-gate] {name} 거부 — 이 저장소의 작업 트리를 되돌리는"
                " 명령은 남의 미커밋 작업을 지운다 (실사고: 2026-09-01 전이·노트"
                " 113건 유실, REQ-20260901-004). 옛 버전은 `git show <rev>:<경로>`"
                " 로 읽고, 정말 필요하면 사람의 확인을 받아 명령 앞에"
                " `S9_GIT_OK=1 ` 을 붙여라.\n")
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
