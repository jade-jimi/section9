#!/usr/bin/env python3
"""section9 harness guard (git pre-commit hook).

보호 경로(harness)가 커밋에 포함되면 현재 사용자의 role을 확인해
admin이 아니면 커밋을 거부한다.

인가(authorization)만 있고 인증(authentication)은 없다 — S9_USER 위조로
우회 가능하며, 이는 의도된 설계다(실수 방지 + 규율 + 감사가 목표).
우회 불가능한 최종 게이트는 GitHub branch protection + CODEOWNERS (docs/09).
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "bin"))

PROTECTED = ("bin/", "web/", "harness/", ".github/", ".gitignore")

# 동시 작업 보호 (REQ-20260826-021). 2026-08-26 하루에 같은 뿌리의 사고가 넷 났다.
# 21:42 에는 리드가 `git add web/index.html` 로 커밋하면서 같은 파일을 고치던
# 워커의 진행 중 편집을 함께 담았다 — 결과는 문법적으로 멀쩡해 커밋도 되고
# 서버도 뜨는 **반쪽 상태**였고, 같은 커밋에 들어 있던 테스트조차 통과 못 했다.
# 돌리기만 했으면 잡혔다.
#
# 그래서 게이트 둘: ① 무인 워커가 도는데 방금 만져진 파일을 담으려 하면 막는다
# ② 커밋에 테스트 파일이 있으면 그것만이라도 돌린다(전체 스위트는 2분이라 매
# 커밋에 물릴 수 없다 — 그 무게가 규율을 죽인다).
FRESH_SEC = 90                      # 이 안에 바뀐 파일은 '진행 중'으로 본다
OVERRIDE = "S9_ALLOW_CONCURRENT"    # 사람이 확인했으면 이걸로 지나간다


def current_user():
    u = os.environ.get("S9_USER")
    if u:
        return u
    import getpass
    return getpass.getuser()


def role_of(user):
    profile = os.path.join(ROOT, "users", user, "profile.md")
    try:
        with open(profile, encoding="utf-8") as f:
            for line in f:
                if line.startswith("role:"):
                    return line.split(":", 1)[1].strip()
        return "member"  # 등록됐지만 role 미지정
    except OSError:
        return ""  # 미등록


def live_workers():
    """지금 도는 작업 주체 — s9 에게 묻는다(판정을 두 벌로 두지 않는다).

    무인 워커뿐 아니라 서브에이전트도 포함된다 (REQ-20260827-002). 판정을
    여기 옮겨 오지 않고 `s9 workers` 에게 계속 묻는 덕에, 주체의 종류가
    늘어도 이 훅은 고칠 것이 없었다 — 실제로 서브에이전트를 더할 때
    이 함수는 한 줄도 안 바뀌었다.
    """
    try:
        out = subprocess.run([os.path.join(ROOT, "bin", "s9"), "workers",
                              "--quiet"], capture_output=True, text=True,
                             cwd=ROOT, timeout=15)
        return [l for l in out.stdout.splitlines() if l.strip()]
    except Exception:
        return []


def concurrent_gate(staged):
    """워커가 도는 중에 '방금 만져진' 파일을 담으려 하면 막는다."""
    if os.environ.get(OVERRIDE):
        return
    workers = live_workers()
    if not workers:
        return
    import time
    now = time.time()
    fresh = []
    for f in staged:
        p = os.path.join(ROOT, f)
        try:
            if now - os.path.getmtime(p) < FRESH_SEC:
                fresh.append(f)
        except OSError:
            continue
    if not fresh:
        return
    print("s9-guard: 다른 작업자가 붙어 있는 중에 방금 바뀐 파일을 담으려 합니다.",
          file=sys.stderr)
    print("  지금 도는 작업자:", file=sys.stderr)
    for w in workers[:5]:
        print(f"    {w}", file=sys.stderr)
    print("  방금 바뀐 스테이지 파일:", file=sys.stderr)
    for f in fresh[:10]:
        print(f"    - {f}", file=sys.stderr)
    print("`git add <경로>` 는 '내 변경'이 아니라 '그 파일의 지금 상태'를 담습니다 —",
          file=sys.stderr)
    print("남이 쓰는 중이면 남의 미완성이 이 커밋의 일부가 됩니다(2026-08-26 21:42 실사고).",
          file=sys.stderr)
    print("`git diff --cached` 로 담기는 내용을 실제로 읽고, 네 것만 맞으면",
          file=sys.stderr)
    print(f"`{OVERRIDE}=1 git commit ...` 으로 진행하세요.", file=sys.stderr)
    sys.exit(1)


def staged_tests_gate(staged):
    """커밋에 테스트 파일이 있으면 그것만이라도 돌린다.

    21:42 커밋은 같은 커밋에 들어 있던 테스트조차 통과 못 했다. 전체 스위트는
    2분이라 매 커밋에 물리면 규율이 먼저 죽으므로, **담긴 테스트**로 좁힌다.
    """
    names = [os.path.basename(f)[len("test_"):-len(".py")]
             for f in staged
             if f.startswith("tests/test_") and f.endswith(".py")]
    if not names:
        return
    r = subprocess.run(["python3", "tests/", *names], capture_output=True,
                       text=True, cwd=ROOT, timeout=600)
    if r.returncode == 0:
        return
    print("s9-guard: 이 커밋에 담긴 테스트가 실패합니다 — 커밋을 멈춥니다.",
          file=sys.stderr)
    print(f"  대상: {' '.join(names)}", file=sys.stderr)
    tail = (r.stdout + r.stderr).strip().splitlines()[-25:]
    for line in tail:
        print(f"  {line}", file=sys.stderr)
    sys.exit(1)


def main():
    out = subprocess.run(["git", "diff", "--cached", "--name-only"],
                         capture_output=True, text=True, cwd=ROOT)
    staged = [l for l in out.stdout.splitlines() if l.strip()]
    concurrent_gate(staged)
    staged_tests_gate(staged)
    hits = [f for f in staged if f.startswith(PROTECTED)]
    if not hits:
        sys.exit(0)

    user = current_user()
    role = role_of(user)
    if role == "admin":
        sys.exit(0)

    print("s9-guard: harness 보호 경로가 커밋에 포함되어 있습니다:", file=sys.stderr)
    for f in hits[:10]:
        print(f"  - {f}", file=sys.stderr)
    who = f"{user} (role: {role or '미등록'})"
    print(f"현재 사용자 {who} 는 admin이 아니므로 커밋이 거부됩니다.", file=sys.stderr)
    print("admin이라면: S9_USER=<admin이름> git commit ... 또는 s9 user role 로 역할 부여.",
          file=sys.stderr)
    print("(harness 변경은 PR로 제안하고 admin 승인을 받는 것이 원칙 — docs/09)",
          file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
